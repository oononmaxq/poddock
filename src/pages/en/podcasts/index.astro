---
import '../../../styles/global.css';
import { createDb } from '../../../infrastructure/db/client';
import { podcasts, assets } from '../../../infrastructure/db/schema';
import { eq, and, desc } from 'drizzle-orm';

const db = createDb(Astro.locals.runtime.env.DB);
const selectedCategoryParam = Astro.url.searchParams.get('category');
const selectedCategory = selectedCategoryParam && selectedCategoryParam.trim().length > 0
  ? selectedCategoryParam.trim()
  : null;

const categories = await db
  .select({ category: podcasts.category })
  .from(podcasts)
  .where(eq(podcasts.visibility, 'public'))
  .groupBy(podcasts.category)
  .orderBy(podcasts.category);

const publicPodcasts = await db
  .select({
    id: podcasts.id,
    title: podcasts.title,
    description: podcasts.description,
    category: podcasts.category,
    language: podcasts.language,
    coverImageUrl: assets.publicUrl,
    updatedAt: podcasts.updatedAt,
  })
  .from(podcasts)
  .leftJoin(assets, eq(podcasts.coverImageAssetId, assets.id))
  .where(
    selectedCategory
      ? and(eq(podcasts.visibility, 'public'), eq(podcasts.category, selectedCategory))
      : eq(podcasts.visibility, 'public')
  )
  .orderBy(desc(podcasts.updatedAt));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Shows | PODDOCK</title>
    <meta name="description" content="Browse all public podcast shows on PODDOCK." />
  </head>
  <body class="min-h-screen bg-base-100">
    <header class="navbar bg-base-100 border-b border-base-200 px-4 sm:px-6 lg:px-12">
      <div class="flex-1">
        <a href="/en" class="flex items-center">
          <img src="/mojilogo_white.png" alt="PODDOCK" class="h-10 sm:h-12" />
        </a>
      </div>
    </header>

    <main class="px-4 sm:px-6 lg:px-12 py-10">
      <div class="max-w-6xl mx-auto">
        <h1 class="text-3xl font-bold mb-2">Shows</h1>
        <p class="text-base-content/70 mb-8">Browse all public podcasts.</p>
        {categories.length > 0 && (
          <div class="mb-8">
            <p class="text-sm text-base-content/60 mb-3">Filter by category</p>
            <div class="flex flex-wrap gap-2">
              <a href="/en/podcasts" class:list={['btn btn-sm', { 'btn-primary': !selectedCategory, 'btn-ghost': selectedCategory }]}>
                All
              </a>
              {categories.map(({ category }) => (
                <a
                  href={`/en/podcasts?category=${encodeURIComponent(category)}`}
                  class:list={['btn btn-sm', { 'btn-primary': selectedCategory === category, 'btn-ghost': selectedCategory !== category }]}
                >
                  {category}
                </a>
              ))}
            </div>
          </div>
        )}

        {publicPodcasts.length === 0 ? (
          <div class="alert">
            {selectedCategory ? `No shows found in "${selectedCategory}".` : 'No public shows yet.'}
          </div>
        ) : (
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {publicPodcasts.map((podcast) => (
              <a href={`/p/${podcast.id}`} class="card bg-base-200 hover:bg-base-300 transition-colors">
                <div class="card-body">
                  {podcast.coverImageUrl && (
                    <img src={podcast.coverImageUrl} alt={podcast.title} class="w-16 h-16 rounded-lg object-cover mb-2" />
                  )}
                  <h2 class="card-title text-lg">{podcast.title}</h2>
                  <p class="text-sm text-base-content/70 line-clamp-3">{podcast.description}</p>
                  <div class="mt-2 flex flex-wrap gap-2">
                    <span class="badge badge-outline">{podcast.category}</span>
                    <span class="badge badge-ghost">{podcast.language}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </main>
  </body>
</html>
