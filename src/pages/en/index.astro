---
import '../../styles/global.css';
import { createDb } from '../../infrastructure/db/client';
import { podcasts, episodes, assets } from '../../infrastructure/db/schema';
import { eq, and, desc } from 'drizzle-orm';

const db = createDb(Astro.locals.runtime.env.DB);

const publicPodcasts = await db
  .select({
    id: podcasts.id,
    title: podcasts.title,
    description: podcasts.description,
    category: podcasts.category,
    language: podcasts.language,
    coverImageUrl: assets.publicUrl,
  })
  .from(podcasts)
  .leftJoin(assets, eq(podcasts.coverImageAssetId, assets.id))
  .where(eq(podcasts.visibility, 'public'))
  .orderBy(desc(podcasts.updatedAt))
  .limit(12);

const latestEpisodes = await db
  .select({
    episodeId: episodes.id,
    podcastId: episodes.podcastId,
    title: episodes.title,
    description: episodes.description,
    podcastTitle: podcasts.title,
  })
  .from(episodes)
  .innerJoin(podcasts, eq(episodes.podcastId, podcasts.id))
  .where(and(eq(episodes.status, 'published'), eq(podcasts.visibility, 'public')))
  .orderBy(desc(episodes.publishedAt))
  .limit(10);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>PODDOCK - Discover podcasts faster</title>
    <meta name="description" content="A podcast discovery site for busy listeners. Find shows and episodes before you press play." />
  </head>
  <body class="min-h-screen bg-base-100">
    <header class="navbar bg-base-100 border-b border-base-200 px-4 sm:px-6 lg:px-12">
      <div class="flex-1">
        <a href="/en" class="flex items-center">
          <img src="/mojilogo_white.png" alt="PODDOCK" class="h-10 sm:h-12" />
        </a>
      </div>
      <div class="flex-none">
        <a href="/en/podcasts" class="btn btn-ghost">Shows</a>
      </div>
    </header>

    <main>
      <section class="px-4 sm:px-6 lg:px-12 py-14 sm:py-20 bg-base-200">
        <div class="max-w-5xl mx-auto text-center">
          <h1 class="text-3xl sm:text-5xl font-bold leading-tight mb-5">
            Understand podcasts<br class="sm:hidden" /> before you listen
          </h1>
          <p class="text-base sm:text-lg text-base-content/70 max-w-2xl mx-auto mb-8">
            PODDOCK helps you discover the right podcast quickly with curated show and episode pages.
          </p>
          <a href="/en/podcasts" class="btn btn-primary">Browse shows</a>
        </div>
      </section>

      <section class="px-4 sm:px-6 lg:px-12 py-12">
        <div class="max-w-6xl mx-auto">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold">Featured shows</h2>
            <a href="/en/podcasts" class="link link-primary">See all</a>
          </div>
          {publicPodcasts.length === 0 ? (
            <div class="alert">No public shows yet.</div>
          ) : (
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {publicPodcasts.map((podcast) => (
                <a href={`/p/${podcast.id}`} class="card bg-base-200 hover:bg-base-300 transition-colors">
                  <div class="card-body">
                    {podcast.coverImageUrl && (
                      <img src={podcast.coverImageUrl} alt={podcast.title} class="w-16 h-16 rounded-lg object-cover mb-2" />
                    )}
                    <h3 class="card-title text-lg">{podcast.title}</h3>
                    <p class="text-sm text-base-content/70 line-clamp-3">{podcast.description}</p>
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>

      <section class="px-4 sm:px-6 lg:px-12 pb-16">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-2xl font-bold mb-6">Latest episodes</h2>
          {latestEpisodes.length === 0 ? (
            <div class="alert">No public episodes yet.</div>
          ) : (
            <div class="space-y-3">
              {latestEpisodes.map((episode) => (
                <a href={`/p/${episode.podcastId}/episodes/${episode.episodeId}`} class="block card bg-base-100 border border-base-300 hover:border-primary transition-colors">
                  <div class="card-body py-4">
                    <p class="text-sm text-base-content/60">{episode.podcastTitle}</p>
                    <h3 class="font-semibold">{episode.title}</h3>
                    {episode.description && <p class="text-sm text-base-content/70 line-clamp-2">{episode.description}</p>}
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    </main>
  </body>
</html>
