---
import '../../styles/global.css';
import { ClientRouter, ViewTransitions } from 'astro:transitions';
import { createDb } from '../../infrastructure/db/client';
import { rssSources } from '../../infrastructure/db/schema';
import { fetchAndParseRss } from '../../infrastructure/rss/feed-parser';
import { and, eq } from 'drizzle-orm';
import { FeedEpisodeList } from '../../presentation/ui/components/FeedEpisodeList';
import { FixedAudioPlayer } from '../../presentation/ui/components/FixedAudioPlayer';
import { ChannelSubscriptionButton } from '../../presentation/ui/components/ChannelSubscriptionButton';
import { ToastContainer } from '../../presentation/ui/components/Toast';
import Pagination from '../../presentation/ui/components/Pagination.astro';

const { sourceId } = Astro.params;
const db = createDb(Astro.locals.runtime.env.DB);
const cookieHeader = Astro.request.headers.get('cookie') || '';
const isLoggedIn = cookieHeader.includes('access_token=');

const source = await db
  .select({
    id: rssSources.id,
    name: rssSources.name,
    feedUrl: rssSources.feedUrl,
  })
  .from(rssSources)
  .where(and(eq(rssSources.id, sourceId || ''), eq(rssSources.isActive, true)))
  .get();

if (!source) {
  return Astro.redirect('/404');
}

let feedErrorMessage: string | null = null;
let feed = null;
try {
  feed = await fetchAndParseRss(source.feedUrl);
} catch (error) {
  feedErrorMessage = error instanceof Error ? error.message : 'Failed to fetch RSS';
}
const safeFeed = feed ?? {
  title: source.name || source.id,
  link: null,
  description: '',
  language: 'ja',
  author: '',
  copyright: '',
  ownerName: '',
  ownerEmail: '',
  imageUrl: null,
  categories: [] as string[],
  items: [] as Array<{
    guid: string | null;
    title: string;
    description: string;
    pubDate: string | null;
    link: string | null;
    enclosureUrl: string | null;
  }>,
};
const feedTitle = safeFeed.title || source.name || source.id;
const feedDescription = safeFeed.description.replace(/\s+/g, ' ').trim();
const EPISODE_LIMIT = 12;
const DESCRIPTION_LIMIT = 280;
const sortParam = Astro.url.searchParams.get('sort');
const allowedSorts = ['newest', 'oldest'] as const;
type SortKey = (typeof allowedSorts)[number];
const selectedSort: SortKey = allowedSorts.includes(sortParam as SortKey) ? (sortParam as SortKey) : 'newest';
const pageParam = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;

const truncateText = (text: string, limit: number) => {
  if (text.length <= limit) return text;
  return `${text.slice(0, limit)}...`;
};

const sortedItems = safeFeed.items.slice().sort((a, b) => {
  const aTime = a.pubDate ? Date.parse(a.pubDate) : 0;
  const bTime = b.pubDate ? Date.parse(b.pubDate) : 0;
  return selectedSort === 'oldest' ? aTime - bTime : bTime - aTime;
});

const totalItems = sortedItems.length;
const totalPages = Math.max(1, Math.ceil(totalItems / EPISODE_LIMIT));
const safePage = Math.min(currentPage, totalPages);
const startIndex = (safePage - 1) * EPISODE_LIMIT;
const displayItems = sortedItems.slice(startIndex, startIndex + EPISODE_LIMIT);
const buildEpisodeKey = (item: (typeof displayItems)[number]) =>
  item.guid || item.link || item.enclosureUrl || `${item.title}::${item.pubDate ?? ''}`;
const displayItemsForPlayer = displayItems.map((item, idx) => ({
  id: `${safePage}-${idx}-${item.pubDate || 'no-date'}`,
  episodeKey: buildEpisodeKey(item),
  title: item.title,
  description: item.description ? truncateText(item.description, DESCRIPTION_LIMIT) : '',
  pubDate: item.pubDate,
  link: item.link,
  enclosureUrl: item.enclosureUrl,
}));
const firstEpisodeLink = safeFeed.items
  .filter((item) => Boolean(item.link))
  .slice()
  .sort((a, b) => {
    const aTime = a.pubDate ? Date.parse(a.pubDate) : Number.POSITIVE_INFINITY;
    const bTime = b.pubDate ? Date.parse(b.pubDate) : Number.POSITIVE_INFINITY;
    return aTime - bTime;
  })[0]?.link ?? null;
const outboundChannelLink = safeFeed.link || firstEpisodeLink;
const listingInquiryUrl = `/removal-request?sourceId=${encodeURIComponent(source.id)}&feedUrl=${encodeURIComponent(source.feedUrl)}`;
const hasRightsInfo = Boolean(safeFeed.copyright || safeFeed.ownerName);

const buildFeedUrl = (next: { sort?: SortKey; page?: number }) => {
  const params = new URLSearchParams();
  const sort = next.sort ?? selectedSort;
  const page = next.page ?? safePage;
  if (sort !== 'newest') params.set('sort', sort);
  if (page > 1) params.set('page', String(page));
  const query = params.toString();
  return query ? `/feeds/${sourceId}?${query}#episodes` : `/feeds/${sourceId}#episodes`;
};
const baseUrl = Astro.locals.runtime.env.BASE_URL || Astro.url.origin;
const canonicalUrl = new URL(`/feeds/${source.id}`, baseUrl).toString();
const ogImageUrl = safeFeed.imageUrl || new URL('/mojilogo_white.png', baseUrl).toString();
const shouldNoindex = safePage > 1 || selectedSort !== 'newest';
const robotsContent = shouldNoindex ? 'noindex,follow' : 'index,follow';
const feedMetaDescription = (safeFeed.description || `${feedTitle} の番組情報`).slice(0, 160);
const podcastJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: feedTitle,
  description: safeFeed.description || '',
  inLanguage: safeFeed.language || 'ja',
  image: ogImageUrl,
  url: canonicalUrl,
  author: safeFeed.author
    ? {
        '@type': 'Person',
        name: safeFeed.author,
      }
    : undefined,
};
---

<!doctype html>
<html lang={safeFeed.language || 'ja'} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{feedTitle} | PODDOCK</title>
    <meta name="description" content={feedMetaDescription} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PODDOCK" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={`${feedTitle} | PODDOCK`} />
    <meta property="og:description" content={feedMetaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${feedTitle} | PODDOCK`} />
    <meta name="twitter:description" content={feedMetaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(podcastJsonLd)} />
    <ViewTransitions />
  </head>
  <body class="min-h-screen bg-base-100 pb-28">
    <header class="navbar bg-base-100 border-b border-base-200 px-4 sm:px-6 lg:px-12">
      <div class="flex-1">
        <a href="/" class="flex items-center">
          <img src="/mojilogo_white.png" alt="PODDOCK" class="h-10 sm:h-12" />
        </a>
      </div>
      <div class="flex-none">
        {isLoggedIn ? (
          <div class="dropdown dropdown-end">
            <div tabIndex={0} role="button" class="btn btn-ghost btn-circle" aria-label="メニュー">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </div>
            <ul id="auth-menu-list" tabIndex={0} class="menu menu-sm dropdown-content z-[80] mt-2 w-44 rounded-box border border-base-300 bg-base-100 p-2 shadow">
              <li><a href="/">トップページ</a></li>
              <li><a href="/mypage">マイページ</a></li>
              <li><button type="button" onclick="document.getElementById('about-poddock-dialog')?.showModal()">ポッドドックとは？</button></li>
              <li><button type="button" id="logout-btn">ログアウト</button></li>
            </ul>
          </div>
        ) : (
          <div class="dropdown dropdown-end">
            <div tabIndex={0} role="button" class="btn btn-ghost btn-circle" aria-label="メニュー">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </div>
            <ul id="auth-menu-list" tabIndex={0} class="menu menu-sm dropdown-content z-[80] mt-2 w-44 rounded-box border border-base-300 bg-base-100 p-2 shadow">
              <li><a href="/login">ログイン</a></li>
              <li><button type="button" onclick="document.getElementById('about-poddock-dialog')?.showModal()">ポッドドックとは？</button></li>
            </ul>
          </div>
        )}
      </div>
    </header>

    <main class="px-4 sm:px-6 lg:px-12 pt-2 sm:pt-4 pb-10">
      <div class="max-w-5xl mx-auto">
        <div class="mb-4">
          <div class="relative overflow-hidden rounded-xl border border-base-300 bg-base-200 mb-4">
            {safeFeed.imageUrl ? (
              <img src={safeFeed.imageUrl} alt={feedTitle} class="w-full aspect-square object-cover" />
            ) : (
              <div class="w-full aspect-square bg-base-300 flex items-center justify-center">
                <span class="text-base-content/50">No Image</span>
              </div>
            )}
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/55 to-transparent px-3 py-2">
              <div class="channel-title-marquee text-white text-base sm:text-lg font-bold">
                <span>{feedTitle}</span>
              </div>
            </div>
          </div>
          {feedDescription ? (
            <>
              <p class="text-sm text-base-content/80 overflow-hidden text-ellipsis whitespace-nowrap">
                {feedDescription}
              </p>
              <div class="mt-1 flex justify-end">
                <button type="button" class="link link-hover text-xs text-base-content/70" onclick="document.getElementById('feed-description-dialog')?.showModal()">
                  詳細表示
                </button>
              </div>
            </>
          ) : (
            <p class="text-base-content/70">説明はありません。</p>
          )}
          <div class="mt-3 flex items-center justify-end gap-2 flex-wrap">
            {outboundChannelLink && (
              <a href={outboundChannelLink} class="btn btn-sm btn-outline" target="_blank" rel="noopener noreferrer">
                配信元ページ
              </a>
            )}
            <ChannelSubscriptionButton client:load sourceId={source.id} initialLoggedIn={isLoggedIn} />
          </div>
        </div>

        <section id="episodes">
          {feedErrorMessage && (
            <div class="alert alert-warning mb-4">
              <span>RSSの取得に失敗しました。時間をおいて再度アクセスしてください。</span>
            </div>
          )}
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold">エピソード</h2>
            <span class="badge badge-outline">表示 {displayItems.length} / 全 {safeFeed.items.length}</span>
          </div>
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <span class="text-sm text-base-content/60">並び順:</span>
            <a href={buildFeedUrl({ sort: 'newest', page: 1 })} class:list={['btn btn-xs', { 'btn-primary': selectedSort === 'newest', 'btn-ghost': selectedSort !== 'newest' }]}>
              新しい順
            </a>
            <a href={buildFeedUrl({ sort: 'oldest', page: 1 })} class:list={['btn btn-xs', { 'btn-primary': selectedSort === 'oldest', 'btn-ghost': selectedSort !== 'oldest' }]}>
              古い順
            </a>
          </div>
          {displayItems.length === 0 ? (
            <div class="alert">エピソードがありません。</div>
          ) : (
            <FeedEpisodeList
              client:load
              sourceId={source.id}
              podcastTitle={feedTitle}
              podcastImageUrl={safeFeed.imageUrl}
              items={displayItemsForPlayer}
            />
          )}

          <Pagination currentPage={safePage} totalPages={totalPages} getPageUrl={(page) => buildFeedUrl({ page })} />
        </section>
      </div>
    </main>
    <div id="fixed-audio-player-shell" transition:persist transition:name="fixed-audio-player">
      <FixedAudioPlayer client:load />
    </div>
    <ToastContainer client:load />
    <ClientRouter />
    <dialog id="about-poddock-dialog" class="modal">
      <div class="modal-box max-w-lg">
        <h3 class="font-bold text-lg">ポッドドックとは？</h3>
        <p class="py-2 text-sm text-base-content/80 leading-relaxed">
          ポッドドックは、Podcastを見つけやすくするための発見サイトです。
          RSSなど公開されている情報をベースに、番組情報を掲載しています。
          カテゴリや更新順で番組を探し、気になる番組の詳細ページからすぐ再生できます。
        </p>
        <div class="modal-action">
          <form method="dialog">
            <button class="btn btn-sm">閉じる</button>
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
    <dialog id="feed-description-dialog" class="modal">
      <div class="modal-box max-w-lg">
        <h3 class="font-bold text-lg mb-2">番組説明</h3>
        <p class="text-sm text-base-content/80 leading-relaxed whitespace-pre-wrap break-words">
          {feedDescription || '説明はありません。'}
        </p>
        {hasRightsInfo && (
          <div class="mt-3 rounded-lg border border-base-300 bg-base-200 px-3 py-2 text-xs text-base-content/80 space-y-1">
            {safeFeed.copyright && (
              <p>
                <span class="font-semibold">権利表記:</span> {safeFeed.copyright}
              </p>
            )}
            {safeFeed.ownerName && (
              <p>
                <span class="font-semibold">権利者名:</span> {safeFeed.ownerName}
              </p>
            )}
          </div>
        )}
        <div class="mt-3 flex justify-end">
          <a href={listingInquiryUrl} class="link link-hover text-xs text-base-content/70">
            この掲載に関する問い合わせ
          </a>
        </div>
        <div class="modal-action">
          <form method="dialog">
            <button class="btn btn-sm">閉じる</button>
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
    <script>
      const authMenu = document.getElementById('auth-menu-list');
      const loggedInMenuHtml = `
        <li><a href="/">トップページ</a></li>
        <li><a href="/mypage">マイページ</a></li>
        <li><button type="button" onclick="document.getElementById('about-poddock-dialog')?.showModal()">ポッドドックとは？</button></li>
        <li><button type="button" id="logout-btn">ログアウト</button></li>
      `;
      const loggedOutMenuHtml = `
        <li><a href="/login">ログイン</a></li>
        <li><button type="button" onclick="document.getElementById('about-poddock-dialog')?.showModal()">ポッドドックとは？</button></li>
      `;

      const handleLogout = async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
        } catch {
          // ignore
        }
        window.location.href = '/login';
      };

      const bindLogoutHandler = () => {
        const logoutButton = document.getElementById('logout-btn');
        if (!logoutButton || logoutButton.getAttribute('data-bound') === '1') return;
        logoutButton.setAttribute('data-bound', '1');
        logoutButton.addEventListener('click', handleLogout);
      };

      const renderAuthMenu = (isAuthenticated) => {
        if (!authMenu) return;
        authMenu.innerHTML = isAuthenticated ? loggedInMenuHtml : loggedOutMenuHtml;
        bindLogoutHandler();
      };

      const syncAuthMenu = async () => {
        try {
          const response = await fetch('/api/auth/status', { credentials: 'include', cache: 'no-store' });
          if (!response.ok) return;
          const data = await response.json();
          renderAuthMenu(Boolean(data?.authenticated));
        } catch {
          // ignore
        }
      };

      const refreshAuthMenu = () => {
        syncAuthMenu();
      };

      document.addEventListener('astro:page-load', refreshAuthMenu);
      document.addEventListener('astro:after-swap', refreshAuthMenu);
      bindLogoutHandler();
      syncAuthMenu();
    </script>
    <style>
      @keyframes channel-title-marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
      }
      .channel-title-marquee {
        overflow: hidden;
        white-space: nowrap;
      }
      .channel-title-marquee > span {
        display: inline-block;
        padding-left: 100%;
        animation: channel-title-marquee 16s linear infinite;
        will-change: transform;
        white-space: nowrap;
        line-height: 1.1;
      }
      @media (prefers-reduced-motion: reduce) {
        .channel-title-marquee > span {
          animation: none;
          padding-left: 0;
        }
      }
    </style>
  </body>
</html>
