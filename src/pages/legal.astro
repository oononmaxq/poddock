---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>運営者情報 | PODDOCK</title>
  </head>
  <body class="min-h-screen bg-base-100">
    <!-- Header -->
    <header class="navbar bg-base-100 border-b border-base-200 px-4 sm:px-6 lg:px-12">
      <div class="flex-1">
        <a href="/" class="flex items-center">
          <img src="/mojilogo_white.png" alt="PODDOCK" class="h-10 sm:h-14" />
        </a>
      </div>
      <div class="flex-none gap-2">
        <a href="/login" class="btn btn-ghost btn-sm sm:btn-md">ログイン</a>
      </div>
    </header>

    <!-- Content -->
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <h1 class="text-2xl sm:text-3xl font-bold mb-8">運営者情報</h1>

      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <tbody>
            <tr>
              <th class="w-1/3 align-top">事業者</th>
              <td>ブルースペース合同会社</td>
            </tr>
            <tr>
              <th class="align-top">運営責任者</th>
              <td>大野 正尭</td>
            </tr>
            <tr>
              <th class="align-top">所在地</th>
              <td>
                <!-- 住所を入力 --><br />
                <span class="text-sm text-base-content/50">※請求があった場合、遅滞なく開示いたします</span>
              </td>
            </tr>
            <tr>
              <th class="align-top">電話番号</th>
              <td>
                <!-- 電話番号を入力 --><br />
                <span class="text-sm text-base-content/50">※請求があった場合、遅滞なく開示いたします</span>
              </td>
            </tr>
            <tr>
              <th class="align-top">メールアドレス</th>
              <td>support@poddock.io</td>
            </tr>
            <tr>
              <th class="align-top">サイトURL</th>
              <td>https://poddock.io</td>
            </tr>
            <tr>
              <th class="align-top">現在の提供形態</th>
              <td>Podcast発見・紹介サイト（現在は無料で公開しています）</td>
            </tr>
            <tr>
              <th class="align-top">掲載削除依頼窓口</th>
              <td><a href="/removal-request" class="link link-primary">掲載削除依頼ページ</a> または support@poddock.io</td>
            </tr>
            <tr>
              <th class="align-top">動作環境</th>
              <td>
                最新版のGoogle Chrome<br />
                インターネット接続環境
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </main>

    <Footer />
  </body>
</html>
