---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const sourceId = Astro.url.searchParams.get('sourceId') || '';
const feedUrl = Astro.url.searchParams.get('feedUrl') || '';
const mailSubject = 'PODDOCK 掲載削除依頼';
const mailBody = `以下の掲載削除を希望します。

sourceId: ${sourceId}
feedUrl: ${feedUrl}
番組名:
依頼者名:
依頼理由:
本人確認情報（番組運営者と確認できる情報）:
`;
const mailtoHref = `mailto:support@poddock.io?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
---

<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>掲載削除依頼 | PODDOCK</title>
  </head>
  <body class="min-h-screen bg-base-100 flex flex-col">
    <header class="navbar bg-base-100 border-b border-base-200 px-4 sm:px-6 lg:px-12">
      <div class="flex-1">
        <a href="/" class="flex items-center">
          <img src="/mojilogo_white.png" alt="PODDOCK" class="h-10 sm:h-14" />
        </a>
      </div>
      <div class="flex-none gap-2">
        <a href="/login" class="btn btn-ghost btn-sm sm:btn-md">ログイン</a>
      </div>
    </header>

    <main class="flex-1 max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <h1 class="text-2xl sm:text-3xl font-bold mb-2">掲載削除依頼</h1>
      <p class="text-base-content/70 mb-6">
        PODDOCKに掲載されている番組情報の削除を希望する場合は、以下の内容を添えてご連絡ください。
      </p>

      <div class="card bg-base-200 mb-6">
        <div class="card-body">
          <h2 class="card-title text-lg">送っていただきたい情報</h2>
          <ul class="list-disc list-inside text-sm text-base-content/80 space-y-1">
            <li>番組名</li>
            <li>対象URL（sourceId / feed URL）</li>
            <li>依頼者名</li>
            <li>依頼理由</li>
            <li>番組運営者本人と確認できる情報</li>
          </ul>
          {sourceId && (
            <p class="text-xs text-base-content/60 mt-2">sourceId: {sourceId}</p>
          )}
          {feedUrl && (
            <p class="text-xs text-base-content/60 break-all">feedUrl: {feedUrl}</p>
          )}
        </div>
      </div>

      <a href={mailtoHref} class="btn btn-primary">
        メールで削除依頼を送る
      </a>
    </main>

    <Footer />
  </body>
</html>
