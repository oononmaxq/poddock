---
import '../../styles/global.css';
import { ClientRouter, ViewTransitions } from 'astro:transitions';
import { FavoriteEpisodesPage } from '../../presentation/ui/components/FavoriteEpisodesPage';
import { FixedAudioPlayer } from '../../presentation/ui/components/FixedAudioPlayer';

const cookieHeader = Astro.request.headers.get('cookie') || '';
const isLoggedIn = cookieHeader.includes('access_token=');
if (!isLoggedIn) {
  return Astro.redirect('/login');
}
---

<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>お気に入りエピソード | PODDOCK</title>
    <ViewTransitions />
  </head>
  <body class="min-h-screen bg-base-100 pb-28">
    <header class="navbar bg-base-100 border-b border-base-200 px-4 sm:px-6 lg:px-12">
      <div class="flex-1">
        <a href="/" class="flex items-center">
          <img src="/mojilogo_white.png" alt="PODDOCK" class="h-10 sm:h-12" />
        </a>
      </div>
      <div class="flex-none">
        <div class="dropdown dropdown-end">
          <div tabIndex={0} role="button" class="btn btn-ghost btn-circle" aria-label="メニュー">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </div>
          <ul tabIndex={0} class="menu menu-sm dropdown-content z-[80] mt-2 w-44 rounded-box border border-base-300 bg-base-100 p-2 shadow">
            <li><a href="/">トップページ</a></li>
            <li><a href="/mypage">マイページ</a></li>
            <li><button type="button" onclick="document.getElementById('about-poddock-dialog')?.showModal()">ポッドドックとは？</button></li>
            <li><button type="button" id="logout-btn">ログアウト</button></li>
          </ul>
        </div>
      </div>
    </header>
    <main class="px-4 sm:px-6 lg:px-12 py-6">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-3xl font-bold mb-6">お気に入りエピソード</h1>
        <FavoriteEpisodesPage client:load />
      </div>
    </main>
    <div id="fixed-audio-player-shell" transition:persist transition:name="fixed-audio-player">
      <FixedAudioPlayer client:load />
    </div>
    <ClientRouter />
    <dialog id="about-poddock-dialog" class="modal">
      <div class="modal-box max-w-lg">
        <h3 class="font-bold text-lg">ポッドドックとは？</h3>
        <p class="py-2 text-sm text-base-content/80 leading-relaxed">
          ポッドドックは、Podcastを見つけやすくするための発見サイトです。
          RSSなど公開されている情報をベースに、番組情報を掲載しています。
          カテゴリや更新順で番組を探し、気になる番組の詳細ページからすぐ再生できます。
        </p>
        <div class="modal-action">
          <form method="dialog">
            <button class="btn btn-sm">閉じる</button>
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
        } catch {
          // ignore
        }
        window.location.href = '/login';
      });
    </script>
  </body>
</html>
